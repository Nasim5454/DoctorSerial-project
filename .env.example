# Port for running the full-stack server
PORT=3000

# JWT Secret for signing role-based session tokens
JWT_SECRET="doctor_serial_super_secret_jwt_key_2026"

# MongoDB Connection URI (Optional: connects to remote/local MongoDB if provided, or uses embedded document store)
MONGODB_URI="mongodb://localhost:27017/doctorserial"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# Client URL for CORS (defaults to http://localhost:3000)
CLIENT_URL="http://localhost:3000"

# GEMINI_API_KEY: Injected by AI Studio if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
